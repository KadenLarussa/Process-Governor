<UserControl x:Class="ProcessGovernor.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Logs" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="Severity" Foreground="{StaticResource MutedTextBrush}" />
                <ComboBox ItemsSource="{Binding SeverityOptions}" SelectedItem="{Binding SeverityFilter}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                <TextBlock Text="Search" Foreground="{StaticResource MutedTextBrush}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" Margin="0,5,0,0"
                         AutomationProperties.Name="Search logs" />
            </StackPanel>
            <Button Grid.Column="2" Content="Export JSON" Command="{Binding ExportJsonCommand}" Margin="0,19,8,0" />
            <Button Grid.Column="3" Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,19,0,0" />
        </Grid>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding LogsView}"
                  SelectedItem="{Binding SelectedEntry}"
                  SelectionMode="Single"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding LocalTimestamp}" Width="155" ElementStyle="{StaticResource TableText}" />
                <DataGridTemplateColumn Header="Severity" SortMemberPath="Severity" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Severity}" Foreground="{Binding Severity, Converter={StaticResource SeverityBrushConverter}}"
                                       Style="{StaticResource TableText}" FontWeight="SemiBold" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="165" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" ElementStyle="{StaticResource TableText}" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="180" ElementStyle="{StaticResource TableText}" />
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" Style="{StaticResource InsetBorder}">
            <StackPanel>
                <TextBlock Text="Event details" Style="{StaticResource SectionTitle}" />
                <TextBox Text="{Binding SelectedEntryDetails, Mode=OneWay}" IsReadOnly="True"
                         Height="78" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Selected log entry details" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
