<Window x:Class="ProcessGovernor.Views.StartupDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Governor"
        Icon="../Assets/ProcessGovernor.png"
        Width="700"
        Height="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{StaticResource WindowBrush}"
        Opacity="0"
        Loaded="Window_Loaded">
    <Grid x:Name="RootContent" Margin="26">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="StartupTranslate" Y="8" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Width="38"
                   Height="38"
                   HorizontalAlignment="Left"
                   Source="../Assets/ProcessGovernor.png"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Process Governor" FontSize="25" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Verifying local services before launch" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="SYSTEM READINESS"
                       Style="{StaticResource BadgeText}"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource CardBorder}"
                Margin="0,20,0,14"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                    <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                                 Minimum="0"
                                 Maximum="100"
                                 Margin="0,12,0,0"
                                 Style="{StaticResource AccentProgressBar}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="{Binding PassedCount}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                    <TextBlock Text=" pass  " Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding WarningCount}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                    <TextBlock Text=" warn  " Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding FailedCount}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" />
                    <TextBlock Text=" fail" Style="{StaticResource MutedText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource InsetBorder}"
                Padding="8">
            <ListBox ItemsSource="{Binding Checks}"
                     ItemContainerStyle="{StaticResource AnimatedStartupListItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>

                            <Border Background="{StaticResource FieldSurfaceBrush}"
                                    BorderBrush="{Binding StatusBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,4"
                                    HorizontalAlignment="Left"
                                    MinWidth="58">
                                <TextBlock Text="{Binding StatusText}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="12" />
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding DurationText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="&#xE72E;"
                       FontFamily="Segoe Fluent Icons"
                       Foreground="{DynamicResource AccentBrush}"
                       Margin="0,1,8,0" />
            <TextBlock Text="Local-only checks. No telemetry, cloud calls, or synthetic performance claims."
                       Style="{StaticResource MutedText}" />
        </StackPanel>
    </Grid>
</Window>
