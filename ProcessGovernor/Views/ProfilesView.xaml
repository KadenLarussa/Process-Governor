<UserControl x:Class="ProcessGovernor.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Style="{StaticResource EditorSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,20">
            <TextBlock Text="Profiles" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding SaveStatus}" Style="{StaticResource MutedText}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.RowSpan="2" Margin="0,0,22,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="New profile" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="New profile name" />
                <Button Content="Add profile" Command="{Binding AddProfileCommand}" Margin="0,8,0,0" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="Saved profiles" Style="{StaticResource SectionTitle}" />
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                        <Setter Property="Text" Value="On standby" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Text" Value="Manually active" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter Property="Text" Value="Disabled" />
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding TemporaryOverrideUntilUtc.LocalDateTime, StringFormat='Override until {0:g}', FallbackValue=''}"
                                       Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <TextBlock Grid.Row="1" Grid.Column="1" Text="Select or add a profile."
                   Style="{StaticResource MutedText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Visibility="{Binding HasSelection, Converter={StaticResource FalseToVisibilityConverter}}" />

        <Grid Grid.Row="1" Grid.Column="1" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{Binding SelectedProfile.Name}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Auto-activate app" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedProfile.AutoActivateProcessName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Executable name, such as cs2.exe. Leave empty for manual activation." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Order" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SelectedProfile.PriorityOrder, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Lower numbers take precedence when multiple profiles match." />
                    </StackPanel>
                    <ToggleButton Grid.Column="3" VerticalAlignment="Bottom" Style="{StaticResource OptionToggleButton}"
                                  IsChecked="{Binding SelectedProfile.Enabled}"
                                  Content="{Binding SelectedProfile.Enabled, Converter={StaticResource BoolLabelConverter}, ConverterParameter=Enabled/Disabled}" />
                </Grid>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Assigned rules" Style="{StaticResource SectionTitle}" />
            <ListBox Grid.Row="2" ItemsSource="{Binding RuleAssignments}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Right" Width="92" Style="{StaticResource GridToggleButton}"
                                          IsChecked="{Binding IsAssigned}"
                                          Content="{Binding IsAssigned, Converter={StaticResource BoolLabelConverter}, ConverterParameter=Included/Not included}" />
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Trigger}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
            <Border BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="0,10,0,4">
                <WrapPanel>
                    <Button Content="Activate" Command="{Binding ActivateProfileCommand}" Margin="0,0,8,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,6">
                        <Button Content="Activate for" Command="{Binding ActivateTemporaryCommand}" Margin="0,0,6,0" />
                        <TextBox Width="58" Text="{Binding TemporaryOverrideMinutes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,6,0" AutomationProperties.Name="Activation duration in minutes" />
                        <TextBlock Text="min" VerticalAlignment="Center" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <Button Content="Clear activation" Command="{Binding ClearActiveProfilesCommand}" Margin="0,0,0,6"
                            ToolTip="Clear manual activation and temporary overrides. App-based activation still applies." />
                </WrapPanel>
            </Border>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Delete profile" Command="{Binding DeleteProfileCommand}" Margin="0,0,8,0" />
                <Button Content="Save changes" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
